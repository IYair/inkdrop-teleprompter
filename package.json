{
  "name": "teleprompter",
  "main": "./lib/index",
  "version": "1.4.0",
  "description": "A local-first teleprompter for reading the active Inkdrop note while recording.",
  "author": "Yair Chan",
  "repository": {
    "type": "git",
    "url": "https://github.com/IYair/inkdrop-teleprompter.git"
  },
  "homepage": "https://github.com/IYair/inkdrop-teleprompter#readme",
  "bugs": {
    "url": "https://github.com/IYair/inkdrop-teleprompter/issues"
  },
  "keywords": [
    "teleprompter",
    "video",
    "creator",
    "script"
  ],
  "license": "MIT",
  "files": [
    "lib/index.js",
    "CHANGELOG.md",
    "styles",
    "menus",
    "keymaps",
    "native/Teleprompter Voice.app"
  ],
  "styleSheets": [
    "inkdrop-teleprompter.css"
  ],
  "engines": {
    "inkdrop": "^6.1.3"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "build:voice": "node scripts/build-voice.mjs",
    "test": "node --test --experimental-strip-types test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@inkdropapp/types": "^0.0.12",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "react-redux": "^9.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
